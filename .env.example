# Supabase server-side connection
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 32-byte AES key encoded as exactly 64 hexadecimal characters
INTEGRATION_ENCRYPTION_KEY=

# Long random bearer secret for protected readiness, sync, and legacy debug routes
INTEGRATION_ADMIN_KEY=

# Bullhorn OAuth application and dedicated read-only API user
BULLHORN_CLIENT_ID=
BULLHORN_CLIENT_SECRET=
BULLHORN_USERNAME=
BULLHORN_REDIRECT_URI=https://upply-integration-api.vercel.app/api/bullhorn/oauth/callback

# Legacy server-side diagnostic only; not used by the normal OAuth callback flow
BULLHORN_PASSWORD=
